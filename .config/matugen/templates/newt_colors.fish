# Динамическая TrueColor палитра для утилит на базе libnewt (nmtui, whiptail),
# генерируемая через Matugen для устранения проблем с контрастностью
# дефолтного серого фона и светлого текста в темной/светлой темах.
set -gx NEWT_COLORS "root={{colors.on_surface.default.hex}},{{colors.surface.default.hex}}:window={{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}}:border={{colors.primary.default.hex}},{{colors.surface_container.default.hex}}:shadow=#000000,{{colors.surface.default.hex}}:title={{colors.primary.default.hex}},{{colors.surface_container.default.hex}}:label={{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}}:listbox={{colors.on_surface_variant.default.hex}},{{colors.surface_container.default.hex}}:actlistbox={{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}:actsellistbox={{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}:button={{colors.on_surface.default.hex}},{{colors.surface_container_highest.default.hex}}:actbutton={{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}:compactbutton={{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}}:entry={{colors.on_surface.default.hex}},{{colors.surface_container_highest.default.hex}}:disentry={{colors.outline.default.hex}},{{colors.surface_container.default.hex}}:checkbox={{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}}:actcheckbox={{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}:textbox={{colors.on_surface.default.hex}},{{colors.surface_container.default.hex}}:acttextbox={{colors.on_primary_container.default.hex}},{{colors.primary_container.default.hex}}"
