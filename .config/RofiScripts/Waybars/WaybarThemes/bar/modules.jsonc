{
"custom/System": {
  "tooltip": false,
  "format" : "",
  "on-click": "setsid ~/.config/RofiScripts/Launcher/Launcher.sh"
               },
"custom/powermenu": {
  "tooltip": false,
  "format" : "",
  "on-click": "setsid ~/.config/RofiScripts/powermenu/powermenu.sh"
                    },
"custom/notifications": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -R; swaync-client -rs",
    "escape": true
	                     }, 
"custom/kb_layout": {
  "tooltip": false,
  "format": "{}",
  "exec": "bash ~/.config/waybar/scripts/kb_layout.sh --watch",
  "on-click": "bash ~/.config/waybar/scripts/kb_layout.sh --toggle"
},
"custom/screenrec": {
  "format": "{}",
  "return-type": "json",
  "exec": "bash ~/.config/hypr/scripts/screenrec.sh --waybar",
  "on-click": "bash ~/.config/hypr/scripts/screenrec.sh --waybar-click",
  "on-click-right": "setsid ~/.config/RofiScripts/Recorder/Recorder.sh",
  "signal": 10
},
"custom/power_mode": {
  "return-type": "json",
  "format": "{}",
  "exec": "bash ~/.config/waybar/scripts/power_mode.sh --status",
  "on-click": "bash ~/.config/waybar/scripts/power_mode.sh --cycle",
  "signal": 11
},
"hyprland/window": {
  "format": "{title}",
  "max-length": 80,
  "icon": true,
  "icon-size": 24,
},
"cpu": {
  "interval": 2,
  "format": " {usage}%",
  "tooltip-format": "CPU load: {usage}%"
},
"memory": {
  "interval": 2,
  "format": " {used:0.1f}GiB",
  "tooltip-format": "RAM used: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
},
"hyprland/workspaces": {
 "disable-scroll": true,
  "all-outputs": false,
  "format": "{icon}",
  "format-icons": {
  "default": "󰜌",
  "active": "󰜋",
                  },
"persistent-workspaces" : {
  "1" : [],
  "2" : [],
  "3" : [],
  "4" : [],
  "5" : [],
                           },
                      },  
"tray": {
  "spacing": 10,
        },       
"group/traywer": {
 "orientation": "horizontal",
 "drawer": {
  "transition-left-to-right": false,
  "click-to-reveal": true,
 },
 "modules": [
"custom/trayicon",	
"tray",
 ],
},
"group/volpower": {
 "orientation": "horizontal",
 "modules": [
"group/volume",
"custom/power_mode"
 ]
},
"group/sysstats": {
 "orientation": "horizontal",
 "modules": [
"cpu",
"custom/cpu_temp",
"custom/fan_speed",
"custom/ram_stats"
 ]
},
"group/netblue": {
 "orientation": "horizontal",
 "modules": [
"network",
"bluetooth"
 ]
},
"group/traywermen": {
 "orientation": "horizontal",
 "modules": [
"group/traywer",
"custom/powermenu"
 ]
},
"custom/trayicon": {
	 "format": "",
   "tooltip": false,
},
"clock": {
  "timezone": "Europe/Moscow",
  "locale": "ru_RU.UTF-8",
  "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  "format" : " {:%H:%M}",
  "format-alt" : "󰸗 {:%a %d.%m.%y}", 
    "calendar": {
    "mode"          : "year",
"mode-mon-col"  : 3,
"weeks-pos"     : "right",
"on-scroll"     : 1,
"format": {
"months":     "<span color='#8aa0a3'><b>{}</b></span>",
"days":       "<span color='#1b1c1c'><b>{}</b></span>",
"weeks":      "<span color='#727879'><b>W{}</b></span>",
"weekdays":   "<span color='#4f6264'><b>{}</b></span>",
"today":      "<span color='#ffffff' background='#4f6264'><b>{}</b></span>"
  }
        }, 
        }, 
"network": {
  "tooltip": true,
  "format": "{icon}",
  "format-wifi" : "{icon}",
  "format-icons": {
  "default": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨",]
                  },
  "format-ethernet": "󰤨",
  "format-disconnected": "󰤫",
  "format-disabled": "󰤮",
  "tooltip-format-wifi": "󰤥 {essid} ({signalStrength}%)",
  "tooltip-format-ethernet": " {ifname}",
  "tooltip-format-disconnected": "󰤦 Disconnected!",
  "tooltip-format-disabled": "󰤦 Connection turned off!",
  "on-click": "~/.config/hypr/scripts/toggle_tui.sh nmtui",
  "on-click-right": "setsid ~/.config/swaync/scripts/network.sh",
          },
"bluetooth": {
  "format-on": "󰂯",
  "format-off": "󰂲",
  "format-connected": "󰂯",
  "format-disabled": "󰂲",
  "tooltip-format": "{controller_alias}\n{num_connections} Connected",
  "tooltip-format-connected": "{controller_alias}\n{num_connections} Connected\n\n{device_alias}",
  "tooltip-format-enumerate-connected": "{device_alias}",
  "tooltip-format-enumerate-connected-battery": "{device_alias}\t󰥄 {device_battery_percentage}%",
  "on-click": "~/.config/hypr/scripts/toggle_tui.sh bluetui",
  "on-click-right": "setsid ~/.config/swaync/scripts/bluetooth.sh",
},
"custom/theme": {
  "tooltip": false,
  "format" : "",
  "on-click" : "setsid ~/.config/ThemeSwitcher/Themes/Theme.sh",
  "on-click-right" : "setsid ~/.config/ThemeSwitcher/Rounding/Rounding.sh",
  "on-click-middle": "setsid ~/.config/ThemeSwitcher/Animations/Animations.sh"
                },
"custom/bar": {
  "tooltip": false,
  "format" : "",
  "on-click" : "/home/alex/.config/ThemeSwitcher/Waybars/Waybar.sh",
              },
"pulseaudio": {
  "tooltip": false,
  "scroll-step": 5,
  "format": "{icon}",
  "format-muted": "󰟎",
"format-icons": {
  "default": ["󰋋"]
                },
  "on-click": "pamixer -t",                        
  "on-click-right": "hyprctl dispatch exec '[float; size 879 879] pavucontrol'",        
              }, 
"pulseaudio/slider": {
  "tooltip": false,
  "min": 0,
  "max": 100,
  "orientation" : "horizontal",
                     },
"group/volume": {
 "orientation": "horizontal",
 "drawer" : {
  "transition-left-to-right": false,
  "click-to-reveal": false,
 },
 "modules": [
  "pulseaudio",
  "pulseaudio/slider",
            ],
}, 
"mpris": {
  "tooltip-format" : "{artist}",
  "max-length": 80,
  "tooltip": true,
  "format" : "{player_icon} « {title} »",
  "format-paused" : "{status_icon} « {title} »",
"player-icons": {
  "default" : "",
                },
"status-icons": { 
  "paused": "",
                },
},
"custom/pacman": {
    "format": "{} ",
    "exec": "checkupdates | wc -l",
    "exec-if": "exit 0",                  
    "on-click": "hyprctl dispatch exec \"[float; size 879 879] kitty bash -c \\\"figlet SYSTEMUPDATE! && yay -Syu && pkill -SIGRTMIN+8 waybar\\\"\"",
    "signal": 8,
    "tooltip-format": "{}  System package(s) ready for update" 
},

"custom/cpu_temp": {
  "return-type": "json",
  "exec": "bash ~/.config/waybar/scripts/cpu_temp.sh",
  "format": "{}",
  "tooltip": true
},
"custom/fan_speed": {
  "return-type": "json",
  "exec": "bash ~/.config/waybar/scripts/fan_speed.sh",
  "interval": 2,
  "format": "{}",
  "tooltip": true
},
"custom/ram_stats": {
  "return-type": "json",
  "exec": "bash ~/.config/waybar/scripts/ram_stats.sh",
  "interval": 2,
  "format": "{}",
  "tooltip": true
},
    "custom/left_div#1": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#2": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#3": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#4": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#5": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#6": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#7": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#8": {
		"format": "",
		"tooltip": false
	},

	// inverse
	"custom/left_inv#1": {
		"format": "",
		"tooltip": false
	},
	"custom/left_inv#2": {
		"format": "",
		"tooltip": false
	},

	"custom/right_div#1": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#2": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#3": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#4": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#5": {
		"format": "",
		"tooltip": false
	},

	// inverse
	"custom/right_inv#1": {
	"format": "",
	"tooltip": false
	},
	"battery": {
	    "bat": "BAT0",
	    "adapter": "AC0",
	    "states": {
	        "good": 95,
	        "warning": 30,
	        "critical": 15
	    },	    "format": "{icon} {capacity}%",
	    "format-charging": "󱐋 {capacity}%",
	    "format-plugged": " {capacity}%",
	    "format-alt": "{icon} {time}",
	    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
	},
}
