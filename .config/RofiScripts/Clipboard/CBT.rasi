@import "~/.config/colors/colors.rasi"
@import "~/.config/colors/rofifont.rasi"
@import "~/.config/colors/rofiradius.rasi"

* {
  font: "JetBrainsMono Nerd Font Propo 12";
}

window {
  width: 53em;
  padding: 0.25em;
  border: 0em;         
  border-color: transparent;
  border-radius: var(borderradius);
  transparency: "real";
  background-color: var(surface);
  x-offset: 0em;
  y-offset: 0em;
}

error-message {
  enabled: true;
  padding: 0.25em;
  background-color: transparent;
  border-color: var(primary);
  border-radius: var(borderradius);
}

textbox {
  enabled: true;
  padding: 0.25em 0.5em;
  text-color: var(error);
  background-color: var(surface-container);
  border-radius: var(buttonradius);
  border-color: var(primary);
}

entry {
  hide-cursor-on-empty: true;
  placeholder: " Search clipboard...";
  placeholder-color: var(secondary);
  text-color: var(secondary);
  border: 0em;
  border-color: var(primary);
  padding: 0.25em 0.5em;
  border-radius: var(buttonradius);
  background-color: var(surface-container);
}

listview {
  columns: 3;
  lines: 2;
  margin: 0em;
  padding: 0.25em 0em 0em 0em;
  fixed-columns: true;
  background-color: transparent;
  scrollbar: false;
  cycle: false;
  spacing: 0.25em;
  border: 0em;
}

mainbox {
  background-color: transparent;
  spacing: 0.25em; 
  padding: 0em;
  border-radius: var(borderradius);
  children: [ inputbar, listview ];
}

inputbar {
  padding: 0em;
  background-color: transparent;
  children: [ entry ];
  border: 0em;
}

element {
  orientation: vertical;
  padding: 0.25em;
  spacing: 0em;
  border-radius: var(buttonradius);
  border: 2px;
  border-color: transparent;
  background-color: transparent;
  children: [ element-icon ];
}

element normal.normal, element alternate.normal {
  background-color: transparent;
  text-color: var(secondary);
}

element selected.normal {
  background-color: var(surface-container);
  text-color: var(on-surface);
  border-color: var(primary);
}

element-icon {
  size: 17em; 
  margin: -3.72em 0em;
  horizontal-align: 0.5;
  vertical-align: 0.5;
  background-color: transparent;
  text-color: inherit;
  border-radius: 4px;
}
