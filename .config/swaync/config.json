{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "ignore-gtk-theme" : true,
    "cssPriority" : "user",
    "positionX": "left",
    "positionY": "top",
    "fit-to-screen": false,
    "control-center-margin-top": 20,
    "control-center-margin-bottom": 20,
    "control-center-margin-left": 20,
    "control-center-margin-right": 20,
    "notification-2fa-action": true,
    "timeout": 10,
    "timeout-low": 5,
    "timeout-critical": 0,
    "control-center-preferred-output": "eDP-1",
    "notification-window-width": 500,
    "notification-window-height": -1,
    "notification-grouping": true,
    "notification-window-preferred-output": "eDP-1",
    "image-visibility": "when-available",
    "transition-time": 0,
    "hide-on-action": false,
    "text-empty": "No notifications",
    "control-center-width": 580,
    "fit-to-screen": true,
    "widgets": [
      "mpris",
      "title",
      "dnd",
      "notifications"
    ],
    "widget-config": {
      "notifications": {
        "vexpand": true
      },
    "title": {
      "text": "Notifications",
      "button-text": "󰎟",
      "clear-all-button": true
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
     "autohide": false,
     "show-album-art": "always",
     "loop-carousel": true
    },
    "volume": {
     "label": "󰋎",
     "show-per-app": false,
     "show-per-app-icon": true,
     "empty-list-label": "No audio sources available",
     "animation-type": "slide_down",
     "animation-duration": 500
    }
    }
}
